APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/businesspilot_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
# LangGraph checkpoint connection pool
CHECKPOINT_POOL_MIN_SIZE=1
CHECKPOINT_POOL_MAX_SIZE=2

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# AI model provider: ollama or gemini
CHAT_MODEL_PROVIDER=ollama

# Google Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

FRONTEND_ORIGIN=http://localhost:5173
